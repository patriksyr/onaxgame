{
  "name": "roll-an-onax",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/package.mjs",
    "test": "node --import tsx --test tests/local.test.ts tests/catalog.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "format": "prettier --write src tests scripts/*.mjs *.json *.ts index.html README.md",
    "catalog:build": "node scripts/catalog.mjs",
    "card:add": "node scripts/add-card.mjs",
    "predev": "npm run catalog:build",
    "prebuild": "npm run catalog:build",
    "pretest": "npm run catalog:build",
    "postinstall": "npm run catalog:build"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
