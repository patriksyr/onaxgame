{
  "name": "roll-an-onax",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/package.mjs",
    "test": "node --import tsx --test tests/local.test.ts",
    "test:browser": "node tests/browser.mjs",
    "format": "prettier --write src tests scripts/*.mjs *.json *.ts index.html README.md"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
